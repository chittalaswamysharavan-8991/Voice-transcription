# Server-only Gemini credential. Never expose this through Vite or browser code.
GEMINI_API_KEY="replace-with-server-secret"

# Shared private token required by /api/transcribe and /api/chat.
# Use a long random value and distribute it only to approved users.
VOICE_APP_ACCESS_TOKEN="replace-with-long-random-secret"

# Optional model overrides. Defaults are documented in README.md.
# GEMINI_TRANSCRIPTION_MODEL="gemini-3.6-flash"
# GEMINI_CHAT_MODEL="gemini-3.1-pro-preview"
